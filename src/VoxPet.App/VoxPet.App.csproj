<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>VoxPet</AssemblyName><Platforms>AnyCPU;x64</Platforms>
    <Company>김태중</Company><Authors>김태중</Authors><Product>VoxPet</Product>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VoxPet.Core/VoxPet.Core.csproj"/>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1"/>
    <Resource Include="Assets/Characters/*.png"/>
    <Content Include="Assets/Characters/manifest.json" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../../docs/distribution/*.txt" Exclude="../../docs/distribution/USER-GUIDE.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../../docs/distribution/USER-GUIDE.txt" Link="USER-GUIDE.txt" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
