<UserControl x:Class="VoxPet.App.Views.StudioShell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VoxPet.App.Views" Foreground="#172A3A">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleBool"/>
  <DataTemplate x:Key="StudioTextItem"><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate>
  <DataTemplate x:Key="StudioDeviceItem"><TextBlock Text="{Binding Name}" Foreground="Black"/></DataTemplate>
  <DataTemplate x:Key="StudioCategoryItem"><TextBlock Text="{Binding Value}" Foreground="Black"/></DataTemplate>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172A3A"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#347FFF"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#526778"/><Setter Property="Background" Value="#E3E9F2"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172A3A"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="Black"/></Style></Style.Resources><Setter Property="Foreground" Value="Black"/><Setter Property="Background" Value="White"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#172A3A"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#172A3A"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#DCEAFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#EAF2FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE6EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="4"/></Style>
 </UserControl.Resources>
 <Grid Background="#F1F4F8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.ColumnSpan="2" Background="#3F4C59" Padding="14,9"><DockPanel><Button DockPanel.Dock="Right" Content="트레이" Command="{Binding Main.TrayCommand}"/><Button DockPanel.Dock="Right" Content="방송창 열기" Command="{Binding Main.BroadcastCommand}"/><TextBlock Text="VoxPet Studio" FontSize="21" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/></DockPanel></Border>
  <ListBox Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Navigation}" SelectedIndex="{Binding NavigationIndex}" Background="#E6ECF3" BorderThickness="0" Margin="5"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#172A3A" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
  <ScrollViewer x:Name="PageScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
   <Grid x:Name="ContentGrid"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PreviewColumn" Width="300"/></Grid.ColumnDefinitions>
    <Grid>
     <StackPanel Visibility="{Binding IsHome,Converter={StaticResource VisibleBool}}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="캐릭터를 준비하고 바로 시험하세요" FontSize="22" FontWeight="Bold"/><TextBlock Text="캐릭터 선택 → 의상 착용 → 동작 재생 → 방송창 확인" Margin="0,10" Foreground="#526778"/><Button Content="선택한 캐릭터의 의상 · 동작 보기" Command="{Binding SampleCommand}" HorizontalAlignment="Left"/><TextBlock Text="늘보군과 펠리에 의상17종·동작9종이 들어 있습니다. 캐릭터를 고른 뒤 바로 착용하고 재생하세요." FontSize="12" Margin="0,8"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="마이크 / 데모" FontSize="17" FontWeight="Bold"/><ComboBox ItemsSource="{Binding Main.Devices}" ItemTemplate="{StaticResource StudioDeviceItem}" SelectedItem="{Binding Main.SelectedDevice}" IsEnabled="{Binding Main.CanChooseDevice}" Margin="0,12,0,8"/><WrapPanel><Button Content="입력 시작" Command="{Binding Main.StartCommand}"/><Button Content="중지" Command="{Binding Main.StopCommand}"/><Button Content="{Binding Main.DemoLabel}" Command="{Binding Main.DemoCommand}"/><Button Content="새로고침" Command="{Binding Main.RefreshCommand}"/></WrapPanel><TextBlock Text="{Binding Main.Status}" Margin="0,8"/><TextBlock Text="{Binding Main.Metrics}" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="현재 상태" FontSize="17" FontWeight="Bold"/><TextBlock Text="{Binding RuntimeState}" Margin="0,10"/><TextBlock Text="{Binding PackageStatus}"/><TextBlock Text="{Binding Main.Packages.InputStatus}" FontSize="11"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding IsLibrary,Converter={StaticResource VisibleBool}}">
      <TextBlock Text="캐릭터" FontSize="22" FontWeight="Bold" Margin="5"/><WrapPanel><Button Content="새 캐릭터" Command="{Binding NewCommand}"/><Button Content=".voxpet 등록" Command="{Binding ImportCommand}"/><Button Content="새로고침" Command="{Binding RefreshCommand}"/></WrapPanel><TextBox AutomationProperties.Name="캐릭터 이름 / ID 검색" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="캐릭터 이름 / ID 검색" Margin="4,8"/>
      <ListBox x:Name="LibraryList" TextSearch.TextPath="Name" IsTextSearchEnabled="True" AutomationProperties.Name="캐릭터 목록" ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" MaxHeight="480" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="180"><StackPanel><Image Source="{Binding Image}" Height="130" Stretch="Uniform"/><TextBlock Text="{Binding Name}" Foreground="#172A3A" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8"/><TextBlock Text="{Binding Version}" Foreground="#526778" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="Bold"/><TextBlock Text="{Binding Selected.Description}" Margin="0,8"/><WrapPanel><Button Content="선택하기" Command="{Binding SelectCommand}"/><Button Content="편집하기" Command="{Binding EditCommand}"/><Button Content="내보내기" Command="{Binding ExportCommand}"/><Button Content="관리 복사본 삭제" Command="{Binding DeleteCommand}"/></WrapPanel></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding IsAttachments,Converter={StaticResource VisibleBool}}">
      <TextBlock Text="의상 / 부착물" FontSize="22" FontWeight="Bold" Margin="5"/><WrapPanel><Button Content="선택한 캐릭터의 의상 보기" Command="{Binding SampleCommand}"/><Button Content="모두 해제" Command="{Binding RemoveAttachmentsCommand}"/><Button Content="의상 · 동작 편집" Command="{Binding EditCompanionCommand}"/></WrapPanel><TextBlock Text="착용한 항목은 ‘해제’로 표시됩니다. 한벌옷은 상의·하의와 교체되며, 머리·손 장식은 움직임을 따라갑니다." Margin="5,10"/>
      <TextBlock Text="헤어스타일" FontSize="17" FontWeight="Bold" Margin="5,10"/><ItemsControl ItemsSource="{Binding HairCards}" AutomationProperties.Name="헤어스타일 선택"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="148" Style="{StaticResource Card}"><StackPanel><Image Source="{Binding Image}" Height="64" Stretch="Uniform"/><TextBlock Text="{Binding Name}" Foreground="#172A3A" FontWeight="Bold" Margin="0,5"/><Button Content="{Binding WearLabel}" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Name}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="의상 · 장식" FontSize="17" FontWeight="Bold" Margin="5,10"/><ComboBox ItemsSource="{Binding ClothingCategories}" ItemTemplate="{StaticResource StudioCategoryItem}" SelectedValuePath="Key" SelectedValue="{Binding ClothingCategory}" AutomationProperties.Name="의상 분류" Margin="5,6"/><TextBlock Text="{Binding ClothingCount}" Margin="5,4" FontSize="12"/>
      <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding FilteredClothingCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="180" Style="{StaticResource Card}"><StackPanel><Image Source="{Binding Image}" Height="100" Stretch="Uniform"/><TextBlock Text="{Binding Name}" Foreground="#172A3A" FontWeight="Bold" Margin="0,8"/><Button Content="{Binding WearLabel}" Command="{Binding ToggleCommand}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <Border Style="{StaticResource Card}" Visibility="{Binding IsSheet,Converter={StaticResource VisibleBool}}"><StackPanel><TextBlock Text="추가한 의상" FontSize="17" FontWeight="Bold"/><TextBlock Text="기본 샘플을 착용하면 같은 분류의 추가 의상은 잠시 숨깁니다. 샘플을 해제하면 돌아옵니다." FontSize="12" Margin="0,6"/><WrapPanel><Button Content="이미지 추가" Command="{Binding Main.Wardrobe.ImportCommand}"/><Button Content="배치 / 연결 설정" Tag="5" Click="LegacySettings"/></WrapPanel><ComboBox ItemsSource="{Binding Main.Wardrobe.Categories}" ItemTemplate="{StaticResource StudioCategoryItem}" SelectedValuePath="Key" SelectedValue="{Binding Main.Wardrobe.ImportCategory}" Margin="3,8"/><ItemsControl ItemsSource="{Binding Main.Wardrobe.Items}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled}" Foreground="#172A3A" Margin="5"><CheckBox.Content><TextBlock Text="{Binding Label}" Foreground="#172A3A"/></CheckBox.Content></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Style="{StaticResource Card}" Visibility="{Binding IsImageSet,Converter={StaticResource VisibleBool}}"><StackPanel><TextBlock Text="등록 이미지 세트 의상 / 소품" FontWeight="Bold"/><ComboBox ItemTemplate="{StaticResource StudioTextItem}" ItemsSource="{Binding Main.Runtime.OutfitNames}" SelectedIndex="{Binding Main.Runtime.OutfitIndex}" IsEnabled="{Binding Main.Runtime.CanUse}" Margin="3,8"/><ComboBox ItemTemplate="{StaticResource StudioTextItem}" ItemsSource="{Binding Main.Runtime.WeaponNames}" SelectedIndex="{Binding Main.Runtime.WeaponIndex}" IsEnabled="{Binding Main.Runtime.CanUse}" Margin="3,8"/><Button Content="이미지 세트 설정" Tag="2" Click="LegacySettings"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding IsExpressions,Converter={StaticResource VisibleBool}}">
      <TextBlock Text="표정" FontSize="22" FontWeight="Bold" Margin="5"/>
      <TextBlock Text="슬롯을 눌러 표정을 전환하세요. 의상과 장착 무기는 유지됩니다." Margin="5,10"/>
      <Border Style="{StaticResource Card}" Visibility="{Binding IsLegacy,Converter={StaticResource VisibleBool}}"><StackPanel>
       <TextBlock Text="저장한 표정 · F1~F12" FontSize="17" FontWeight="Bold"/>
       <ItemsControl ItemsSource="{Binding Main.Expressions.Slots}" AutomationProperties.Name="표정 슬롯 선택"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding SwitchCommand}" AutomationProperties.Name="{Binding Label}" MinWidth="120"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="기본 표정 12종 시험" FontSize="17" FontWeight="Bold" Margin="0,16,0,8"/>
       <ItemsControl ItemsSource="{Binding Main.Expressions.TestExpressions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Command="{Binding PreviewCommand}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <WrapPanel><Button Content="12종 전체 테스트" Command="{Binding Main.TestExpressionsCommand}"/><Button Content="테스트 중지" Command="{Binding Main.Expressions.StopTestCommand}"/><Button Content="슬롯 편집 / PNG 등록" Tag="3" Click="LegacySettings"/></WrapPanel>
       <TextBlock Text="{Binding Main.Expressions.Status}" Margin="0,8"/><TextBlock Text="{Binding Main.Expressions.HotkeyStatus}" FontSize="12"/>
      </StackPanel></Border>
      <ItemsControl ItemsSource="{Binding LiveExpressions}" AutomationProperties.Name="등록 캐릭터 표정"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Id}" Click="NativeExpression"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
     <StackPanel Visibility="{Binding IsActions,Converter={StaticResource VisibleBool}}">
      <TextBlock Text="동작" FontSize="22" FontWeight="Bold" Margin="5"/><WrapPanel><Button Content="선택한 캐릭터의 동작 보기" Command="{Binding SampleCommand}"/><Button Content="동작 중지" Command="{Binding StopActionsCommand}"/></WrapPanel><TextBlock Text="재생을 누르면 한 번 재생하고 기본 자세로 돌아옵니다. 의상을 착용한 상태에서도 같은 동작을 시험할 수 있습니다." Margin="5,10"/>
      <Border Style="{StaticResource Card}" Visibility="{Binding IsSheet,Converter={StaticResource VisibleBool}}"><StackPanel><TextBlock Text="장착 무기" FontSize="17" FontWeight="Bold"/><ComboBox ItemsSource="{Binding Main.Equipment.WeaponNames}" ItemTemplate="{StaticResource StudioTextItem}" SelectedIndex="{Binding Main.Equipment.WeaponIndex}" IsEnabled="{Binding Main.Equipment.CanUse}" AutomationProperties.Name="장착 무기 선택" Margin="3,8"/><CheckBox IsChecked="{Binding Main.Equipment.HoldWeapon}" IsEnabled="{Binding Main.Equipment.CanUse}" AutomationProperties.Name="무기 항상 들고 있기"><TextBlock Text="항상 들고 있기"/></CheckBox><TextBlock Text="{Binding Main.Equipment.Status}" FontSize="12" Margin="3,6"/></StackPanel></Border>
      <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding LiveActions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="180"><StackPanel><TextBlock Text="{Binding Name}" Foreground="#172A3A" FontWeight="Bold" Margin="0,5"/><Button Content="재생" Tag="{Binding Id}" Click="NativeAction"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <CheckBox IsChecked="{Binding Main.Packages.MouseEnabled}" Foreground="#172A3A" Margin="6,10"><CheckBox.Content><TextBlock Text="마우스 트리거 사용"/></CheckBox.Content></CheckBox><TextBlock Text="{Binding Main.Packages.InputStatus}" Margin="6"/><ItemsControl ItemsSource="{Binding LiveExpressions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Id}" Click="NativeExpression"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Style="{StaticResource Card}" Visibility="{Binding IsSheet,Converter={StaticResource VisibleBool}}"><StackPanel><TextBlock Text="동작 / 입력 설정" FontSize="17" FontWeight="Bold"/><WrapPanel Visibility="{Binding HasLegacyQuickActions,Converter={StaticResource VisibleBool}}"><Button Content="법규" Tag="0" Click="QuickLegacy"/><Button Content="장난감 총" Tag="1" Click="QuickLegacy"/><Button Content="손하트" Tag="2" Click="QuickLegacy"/><Button Content="장난감 칼" Tag="3" Click="QuickLegacy"/><Button Content="마법봉" Tag="4" Click="QuickLegacy"/></WrapPanel><Button Content="동작 / 입력 세부 설정" Tag="6" Click="LegacySettings"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Visibility="{Binding IsImageSet,Converter={StaticResource VisibleBool}}"><StackPanel><TextBlock Text="등록 이미지 세트 동작" FontWeight="Bold"/><ComboBox ItemTemplate="{StaticResource StudioTextItem}" ItemsSource="{Binding Main.Runtime.ActionNames}" SelectedIndex="{Binding Main.Runtime.ActionIndex}" IsEnabled="{Binding Main.Runtime.CanUse}" Margin="3,8"/><Button Content="액션 재생" Command="{Binding Main.Runtime.PlayCommand}"/><Button Content="이미지 세트 입력 설정" Tag="2" Click="LegacySettings"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding IsSettings,Converter={StaticResource VisibleBool}}"><TextBlock Text="방송 / 설정" FontSize="22" FontWeight="Bold" Margin="5"/><ComboBox ItemTemplate="{StaticResource StudioTextItem}" x:Name="SettingsSection" ItemsSource="{Binding SettingsSections}" SelectedIndex="{Binding Main.SettingsTab}" Margin="4,10" AutomationProperties.Name="설정 항목"/><Border Style="{StaticResource Card}"><Grid x:Name="SettingsHost" MinHeight="520"/></Border></StackPanel>
     <local:CharacterEditorView DataContext="{Binding Editor}" Height="760" Visibility="{Binding DataContext.IsEditor,RelativeSource={RelativeSource AncestorType=local:StudioShell},Converter={StaticResource VisibleBool}}"/>
    </Grid>
    <Border x:Name="SharedPreview" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="공통 미리보기" FontSize="17" FontWeight="Bold"/><TextBlock Text="{Binding CurrentCharacter}" Margin="0,8" FontSize="12"/><Border Background="{StaticResource Checkerboard}" Height="280"><local:CharacterView DataContext="{Binding Main.Character}"/></Border><ProgressBar Value="{Binding Main.VoiceLevel,Mode=OneWay}" Maximum="1" Minimum="0" Height="9" Margin="0,12"/><TextBlock Text="{Binding RuntimeState}" FontSize="11"/><TextBlock Text="{Binding PackageStatus}" FontSize="11" Margin="0,8"/><Button Content="{Binding Main.DemoLabel}" Command="{Binding Main.DemoCommand}"/><Button Content="입력 / 데모 중지" Command="{Binding Main.StopCommand}"/><CheckBox IsChecked="{Binding Main.CharacterMuted}" Foreground="#172A3A" Margin="3,8"><CheckBox.Content><TextBlock Text="입 반응 음소거"/></CheckBox.Content></CheckBox></StackPanel></Border>
   </Grid>
  </ScrollViewer>
  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Status}" Margin="12,5" FontSize="12"/>
 </Grid>
</UserControl>
