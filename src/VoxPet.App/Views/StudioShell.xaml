<UserControl x:Class="VoxPet.App.Views.StudioShell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VoxPet.App.Views" Foreground="#172A3A">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleBool"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172A3A"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#347FFF"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172A3A"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172A3A"/><Setter Property="Padding" Value="7"/><Setter Property="BorderBrush" Value="#CAD5E1"/></Style>
  <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="5"/><Setter Property="BorderBrush" Value="#DFE6EE"/><Setter Property="BorderThickness" Value="1"/></Style>
 </UserControl.Resources>
 <Grid Background="#F1F4F8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.ColumnSpan="2" Background="#3F4C59" Padding="18,12"><DockPanel><Button DockPanel.Dock="Right" Content="방송창 열기" Command="{Binding Main.BroadcastCommand}"/><TextBlock Text="VoxPet 2.0" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/></DockPanel></Border>
  <ListBox Grid.Row="1" ItemsSource="{Binding Navigation}" SelectedIndex="{Binding Page}" Background="#E6ECF3" Foreground="#172A3A" BorderThickness="0" Margin="8"/>
  <Grid Grid.Row="1" Grid.Column="1" Margin="8">
   <Grid Visibility="{Binding IsHome,Converter={StaticResource VisibleBool}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="{Binding Main.Character.Name}" FontWeight="Bold" FontSize="18"/><TextBlock DockPanel.Dock="Right" Text="● 준비됨" Foreground="#27844B"/></DockPanel><Border Grid.Row="1" Background="{StaticResource Checkerboard}" Margin="0,16,0,0"><local:CharacterView DataContext="{Binding Main.Character}"/></Border></Grid></Border>
    <StackPanel Grid.Column="1">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="마이크 입력" FontWeight="Bold" FontSize="16"/><ComboBox ItemsSource="{Binding Main.Devices}" DisplayMemberPath="Name" SelectedItem="{Binding Main.SelectedDevice}" IsEnabled="{Binding Main.CanChooseDevice}" Margin="0,12,0,8"/><ProgressBar Value="{Binding Main.VoiceLevel,Mode=OneWay}" Minimum="0" Maximum="1" Height="13" Foreground="#347FFF"/><TextBlock Text="{Binding Main.Metrics}" TextWrapping="Wrap" FontSize="11" Margin="0,10"/><WrapPanel><Button Content="시작" Command="{Binding Main.StartCommand}"/><Button Content="중지" Command="{Binding Main.StopCommand}"/><Button Content="{Binding Main.DemoLabel}" Command="{Binding Main.DemoCommand}"/></WrapPanel><CheckBox Content="입 반응 음소거" IsChecked="{Binding Main.CharacterMuted}" Foreground="#172A3A" Margin="0,10,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="현재 상태" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding RuntimeState}" Margin="0,12,0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding Main.Packages.InputStatus}" FontSize="11" TextWrapping="Wrap"/><CheckBox Content="캐릭터 마우스 트리거 활성화" IsChecked="{Binding Main.Packages.MouseEnabled}" Foreground="#172A3A" Margin="0,8"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="빠른 동작" FontWeight="Bold" FontSize="16"/><WrapPanel Margin="0,10"><Button Content="손하트" Tag="2" Click="QuickLegacy"/><Button Content="장난감 총" Tag="1" Click="QuickLegacy"/><Button Content="장난감 칼" Tag="3" Click="QuickLegacy"/><Button Content="할퀴기" Tag="0" Click="QuickLegacy"/></WrapPanel><ItemsControl ItemsSource="{Binding Main.Packages.Scene.Runtime.Definition.Actions}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Id}" Click="NativeAction"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="방송창 열기" Command="{Binding Main.BroadcastCommand}"/><StackPanel><TextBlock Text="방송 출력 · 투명 배경" FontWeight="Bold"/><TextBlock Text="{Binding Main.BroadcastWidth,StringFormat=너비 {0:0} DIP}" FontSize="11"/><TextBlock Text="{Binding Main.BroadcastHeight,StringFormat=높이 {0:0} DIP · 목표 60 FPS}" FontSize="11"/></StackPanel></DockPanel></Border>
   </Grid>
   <Grid Visibility="{Binding IsLibrary,Converter={StaticResource VisibleBool}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="+ 새 캐릭터" Command="{Binding NewCommand}"/><Button Content=".voxpet 등록" Command="{Binding ImportCommand}"/><Button Content="↻" Command="{Binding RefreshCommand}"/></WrapPanel><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MinWidth="180" ToolTip="캐릭터 이름 / ID 검색" Margin="5"/></DockPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" Background="Transparent" Foreground="#172A3A" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><Border Width="175" Height="205" Style="{StaticResource Card}"><StackPanel><Image Source="{Binding Image}" Height="135" Stretch="Uniform"/><TextBlock Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6"/><TextBlock Text="{Binding Version}" HorizontalAlignment="Center" FontSize="11"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding Selected.Image}" Height="100"/><StackPanel Grid.Column="1" Margin="15,0"><TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding Selected.Id}" FontSize="11" Margin="0,6"/><TextBlock Text="{Binding Selected.Author}"/><TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="2"><Button Content="선택하기" Command="{Binding SelectCommand}"/><Button Content="편집하기" Command="{Binding EditCommand}"/><Button Content="내보내기" Command="{Binding ExportCommand}"/><Button Content="관리 복사본 삭제" Command="{Binding DeleteCommand}"/></StackPanel></Grid></Border>
   </Grid>
   <ScrollViewer Visibility="{Binding IsAttachments,Converter={StaticResource VisibleBool}}" VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="기존 의상 보관함" Tag="5" Click="LegacySettings"/><TextBlock Text="의상 / 부착물" FontSize="22" FontWeight="Bold"/></DockPanel><TextBlock Text="선택한 .voxpet 캐릭터의 부착물을 착용하세요." Margin="5,12"/><ItemsControl ItemsSource="{Binding LiveAttachments}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="착용 / 해제" Tag="{Binding Id}" Click="WearNative"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Category}" FontSize="11"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Style="{StaticResource Card}" Height="300"><local:CharacterView DataContext="{Binding Main.Character}"/></Border></StackPanel></ScrollViewer>
   <ScrollViewer Visibility="{Binding IsActions,Converter={StaticResource VisibleBool}}" VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="기존 동작 / 입력 설정" Tag="6" Click="LegacySettings"/><TextBlock Text="동작 / 입력" FontSize="22" FontWeight="Bold"/></DockPanel><TextBlock Text="{Binding Main.Packages.InputStatus}" Margin="5,12" TextWrapping="Wrap"/><CheckBox Content="캐릭터 마우스 입력 허용" IsChecked="{Binding Main.Packages.MouseEnabled}" Foreground="#172A3A"/><ItemsControl ItemsSource="{Binding LiveActions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="재생" Tag="{Binding Id}" Click="NativeAction"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Priority,StringFormat=우선순위 {0}}" FontSize="11"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding LiveExpressions}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Id}" Click="NativeExpression"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Style="{StaticResource Card}" Height="260"><local:CharacterView DataContext="{Binding Main.Character}"/></Border></StackPanel></ScrollViewer>
   <local:CharacterEditorView DataContext="{Binding Editor}" Visibility="{Binding DataContext.IsEditor,RelativeSource={RelativeSource AncestorType=local:StudioShell},Converter={StaticResource VisibleBool}}"/>
  </Grid>
  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Status}" Margin="12,5" TextWrapping="Wrap"/>
 </Grid>
</UserControl>
