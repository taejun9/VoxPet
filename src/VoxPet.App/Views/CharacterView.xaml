<UserControl x:Class="VoxPet.App.Views.CharacterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsHitTestVisible="False">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="WearingVisibility"/></UserControl.Resources>
  <!-- 동일한 512px 좌표계를 사용해 창 크기·DPI 변화에도 PNG와 눈물의 위치가 맞는다. -->
  <UserControl.RenderTransform><TranslateTransform Y="{Binding Bounce}"/></UserControl.RenderTransform>
  <Viewbox Stretch="Uniform">
    <Canvas Width="512" Height="512" ClipToBounds="True">
      <ItemsControl ItemsSource="{Binding CostumeLayers}" Width="512" Height="512">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding Image}" Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Visibility="{Binding ShowBehind, Converter={StaticResource WearingVisibility}}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Image Width="512" Height="512" Source="{Binding PreviousSprite}" Opacity="{Binding PreviousOpacity}" RenderOptions.BitmapScalingMode="HighQuality"/>
      <Image Width="512" Height="512" Source="{Binding Sprite}" Opacity="{Binding Blend}" RenderOptions.BitmapScalingMode="HighQuality"/>
      <Path Data="M5,0 C4,5 0,8 0,12 C0,20 10,20 10,12 C10,8 6,5 5,0 Z" Fill="#9ADFFE" Stroke="#65BCEB" StrokeThickness="1" Canvas.Left="{Binding TearLeftX}" Canvas.Top="{Binding TearLeftY}" Opacity="{Binding TearLeftOpacity}"/>
      <Path Data="M5,0 C4,5 0,8 0,12 C0,20 10,20 10,12 C10,8 6,5 5,0 Z" Fill="#9ADFFE" Stroke="#65BCEB" StrokeThickness="1" Canvas.Left="{Binding TearRightX}" Canvas.Top="{Binding TearRightY}" Opacity="{Binding TearRightOpacity}"/>
      <ItemsControl ItemsSource="{Binding CostumeLayers}" Width="512" Height="512">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding Image}" Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Visibility="{Binding ShowInFront, Converter={StaticResource WearingVisibility}}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </Canvas>
  </Viewbox>
</UserControl>
