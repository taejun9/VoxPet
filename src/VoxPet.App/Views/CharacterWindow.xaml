<Window x:Class="VoxPet.App.Views.CharacterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VoxPet.App.Views"
        Title="VoxPet Character" Width="{Binding BroadcastWidth, Mode=TwoWay}" Height="{Binding BroadcastHeight, Mode=TwoWay}" MinWidth="200" MinHeight="200" MaxWidth="1200" MaxHeight="1200" WindowStyle="None" AllowsTransparency="True" Background="{Binding BroadcastBackground}" Topmost="{Binding Topmost}" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True">
  <Window.Resources>
    <!-- Opacity만 0으로 해 native 크기 조절 영역은 유지하고 OBS에 grip 픽셀이 보이지 않게 한다. -->
    <Style TargetType="{x:Type ResizeGrip}"><Setter Property="Opacity" Value="0"/></Style>
  </Window.Resources>
  <!-- 설정창의 DataContext를 공유한다. 배경과 항상 위 옵션은 ViewModel 바인딩으로 함께 갱신된다. -->
  <Grid Background="{Binding BroadcastBackground}" MouseLeftButtonDown="DragCharacter">
    <Grid.ContextMenu><ContextMenu Background="White" Foreground="Black">
      <ContextMenu.Resources>
        <Style TargetType="MenuItem">
          <Setter Property="Foreground" Value="Black"/>
          <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></Setter.Value></Setter>
        </Style>
      </ContextMenu.Resources><MenuItem Header="작게 (320 × 320)" Tag="320" Click="ResizeCharacter"/><MenuItem Header="기본 크기 (480 × 480)" Tag="480" Click="ResizeCharacter"/><MenuItem Header="크게 (640 × 640)" Tag="640" Click="ResizeCharacter"/><Separator/><MenuItem Header="방송창 닫기 (Esc)" Click="CloseCharacter"/></ContextMenu></Grid.ContextMenu>
    <local:CharacterView DataContext="{Binding Character}" Margin="12"/>
  </Grid>
</Window>
