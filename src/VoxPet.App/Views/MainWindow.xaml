<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VoxPet.App.Views" x:Class="VoxPet.App.Views.MainWindow" Icon="/Assets/VoxPet.ico" Title="VoxPet · 목소리로 움직이는 캐릭터" Width="1280" Height="820" MinWidth="480" MinHeight="320" Background="#071722" FontFamily="Segoe UI, Malgun Gothic" WindowStartupLocation="CenterScreen">
  <Grid>
  <local:StudioShell x:Name="StudioSurface"/>
  <Grid x:Name="LayoutRoot" Margin="18">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="148"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.ColumnSpan="2" BorderBrush="#24465E" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/Assets/VoxPet.png" Width="34" Height="34" Margin="0,0,10,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="VoxPet 프로그램 아이콘"/>
          <TextBlock x:Name="TitleText" Text="VoxPet" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="ProjectHeading" Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedCharacter.Name, StringFormat=프로젝트 · {0}}" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubtitleText" Text="준비한 그림에 목소리와 움직임을 더하세요" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="홈" Click="ReturnStudio" Padding="10,7"/>
          <Button x:Name="HeaderTray" Content="트레이" Command="{Binding TrayCommand}" Padding="10,7"/>
          <Button Content="방송 모드 ↗" Command="{Binding BroadcastCommand}" Style="{StaticResource PrimaryButton}" Margin="0" Padding="12,7"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="NavigationRail" Grid.Row="1" Margin="0,0,16,0" Background="#0A1C29" BorderBrush="#24465E" BorderThickness="1" CornerRadius="9" Padding="6,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="8,12,8,8"><TextBlock Text="● 로컬 처리" Foreground="#45D5A0" FontSize="11"/><TextBlock Text="VOICE STUDIO" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
        <ListBox x:Name="NavigationList" SelectedIndex="{Binding SettingsTab, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBoxItem><TextBlock Text="◉  입력 설정" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
          <ListBoxItem><TextBlock Text="∿  음성 반응" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
          <ListBoxItem><TextBlock Text="◌  캐릭터" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
          <ListBoxItem><TextBlock Text="☺  표정 관리" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
          <ListBoxItem><TextBlock Text="▷  동작 테스트" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
          <ListBoxItem><TextBlock Text="◇  의상 관리" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
          <ListBoxItem><TextBlock Text="✦  액션 · 입력" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>
    <!-- 각 탭은 동일한 모델을 공유한다. 작은 창은 내용 크기를 줄여 스크롤 없이 전체 조작을 표시한다. -->
    <Grid x:Name="PanelsGrid" Grid.Row="1" Grid.Column="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <!-- 방송창과 같은 CharacterViewModel의 frozen PNG와 이동량을 표시한다. -->
      <Border x:Name="PreviewCard" VerticalAlignment="Top" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="9" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel><TextBlock Text="01  캐릭터 미리보기" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding Character.Name}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
          <Border Grid.Row="1" Background="{StaticResource Checkerboard}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="12" Margin="0,12,0,16" Padding="10">
            <local:CharacterView DataContext="{Binding Character}"/>
          </Border>
          <StackPanel Grid.Row="2">
            <TextBlock Text="VOICE LEVEL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
            <ProgressBar Value="{Binding VoiceLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="8" Foreground="{StaticResource Accent}" Background="#111A27" BorderThickness="0" Margin="0,8,0,8"/>
            <DockPanel>
              <TextBlock Text="{Binding RawLevel, StringFormat=RAW {0:P0}}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
              <TextBlock Text="{Binding VoiceLevel, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"/>
            </DockPanel>
            <Border Background="#071722" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,16">
              <TextBlock Text="{Binding Metrics}" FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
            </Border>
            <Button Content="방송 출력 시작 ↗" Command="{Binding BroadcastCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
          </StackPanel>
        </Grid>
      </Border>
      <TabControl x:Name="SettingsTabs" SelectedIndex="{Binding SettingsTab, Mode=TwoWay}" Grid.Column="2" Background="#F1F4F8" BorderThickness="0" Foreground="#172A3A" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TabControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioSettingsResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></TabControl.Resources>
        <TabItem Header="마이크">
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Width="440" Margin="0,12,0,0">
              <TabControl Background="#F1F4F8" BorderThickness="0" Foreground="#172A3A" Padding="0">
                <TabItem Header="입력">
                  <StackPanel Margin="8,12,8,0">
                    <TextBlock Text="마이크" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="↻" ToolTip="마이크 장치 새로고침" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
                      <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanChooseDevice}" MinHeight="38" VerticalContentAlignment="Center" AutomationProperties.Name="마이크 선택" Foreground="Black" Background="White">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Foreground="Black" Text="{Binding Name}"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,24">
                      <Button Content="입력 시작" Command="{Binding StartCommand}" Background="{StaticResource Accent}" Foreground="White" MinWidth="100"/>
                      <Button Content="입력 중지" Command="{Binding StopCommand}" MinWidth="100"/>
                      <Button Content="{Binding DemoLabel}" Command="{Binding DemoCommand}" FontSize="11" Padding="10,10"/>
                    </WrapPanel>
                    <ProgressBar Value="{Binding VoiceLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="8" Foreground="{StaticResource Accent}" Background="#EAF1F8" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Metrics}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="음소거 · 권한">
                  <StackPanel Margin="8,12,8,0">
                    <CheckBox Content="캐릭터 음소거" IsChecked="{Binding CharacterMuted}"/>
                    <TextBlock Text="{Binding MuteHotkeyStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding MuteHint}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                    <Button Content="Windows 마이크 권한 설정 열기" Command="{Binding MicrophonePrivacyCommand}" HorizontalAlignment="Left" FontSize="11" Padding="8,6" Margin="0,0,0,12"/>
                  </StackPanel>
                </TabItem>
              </TabControl>
            </StackPanel>
          </Viewbox>
        </TabItem>
        <TabItem Header="반응">
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Width="440" Margin="0,12,0,0">
              <TabControl Background="#F1F4F8" BorderThickness="0" Foreground="#172A3A" Padding="0">
                <TabItem Header="음량">
                  <StackPanel Margin="8,12,8,0">
                    <StackPanel.Resources>
                      <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                        <Setter Property="Margin" Value="0,6,0,8"/>
                      </Style>
                    </StackPanel.Resources>
                    <DockPanel>
                      <TextBlock Text="반응 조정" FontWeight="SemiBold"/>
                      <Button Content="기본값" Command="{Binding ResetCommand}" Padding="8,4" FontSize="11" HorizontalAlignment="Right" Margin="0"/>
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,0">
                      <Button Content="일반 대화" Command="{Binding ConversationCommand}" Padding="8,6" FontSize="11"/>
                      <Button Content="조용한 목소리" Command="{Binding SoftVoiceCommand}" Padding="8,6" FontSize="11"/>
                      <Button Content="빠른 반응" Command="{Binding SnappyCommand}" Padding="8,6" FontSize="11"/>
                    </WrapPanel>
                    <DockPanel Margin="0,18,0,0">
                      <TextBlock Text="Noise Gate"/>
                      <TextBlock Text="{Binding NoiseGate, StringFormat={}{0:F0} dBFS}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                    </DockPanel>
                    <Slider Value="{Binding NoiseGate}" Minimum="-90" Maximum="-10" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Noise Gate"/>
                    <DockPanel>
                      <TextBlock Text="Sensitivity"/>
                      <TextBlock Text="{Binding Sensitivity, StringFormat={}{0:F2} ×}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                    </DockPanel>
                    <Slider Value="{Binding Sensitivity}" Minimum="0" Maximum="4" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Sensitivity"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="소음 측정">
                  <StackPanel Margin="8,12,8,0">
                    <WrapPanel>
                      <Button Content="주변 소음 측정 (3초)" Command="{Binding MeasureNoiseCommand}" Padding="8,6" FontSize="11"/>
                      <Button Content="측정 취소" Command="{Binding CancelNoiseCommand}" Padding="8,6" FontSize="11"/>
                      <Button Content="추천값 적용" Command="{Binding ApplyNoiseCommand}" Padding="8,6" FontSize="11"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding CalibrationStatus}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,12"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="속도">
                  <StackPanel Margin="8,12,8,0">
                    <StackPanel.Resources>
                      <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                        <Setter Property="Margin" Value="0,6,0,8"/>
                      </Style>
                    </StackPanel.Resources>
                    <DockPanel>
                      <TextBlock Text="Attack"/>
                      <TextBlock Text="{Binding AttackMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                    </DockPanel>
                    <Slider Value="{Binding AttackMs}" Minimum="0" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Attack"/>
                    <DockPanel>
                      <TextBlock Text="Release"/>
                      <TextBlock Text="{Binding ReleaseMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                    </DockPanel>
                    <Slider Value="{Binding ReleaseMs}" Minimum="0" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" AutomationProperties.Name="Release" Margin="0,10,0,0"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="입력 범위">
                  <StackPanel Margin="8,12,8,0">
                    <StackPanel.Resources>
                      <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                        <Setter Property="Margin" Value="0,6,0,8"/>
                      </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="작은 목소리에 반응하지 않으면 낮은 입력과 Gate를 함께 낮추세요." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,12"/>
                    <DockPanel>
                      <TextBlock Text="낮은 입력"/>
                      <TextBlock Text="{Binding NormalizeMin, StringFormat={}{0:F0} dBFS}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider Value="{Binding NormalizeMin}" Minimum="-120" Maximum="-1" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="입력 범위 최소"/>
                    <DockPanel>
                      <TextBlock Text="높은 입력"/>
                      <TextBlock Text="{Binding NormalizeMax, StringFormat={}{0:F0} dBFS}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider Value="{Binding NormalizeMax}" Minimum="-119" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="입력 범위 최대"/>
                  </StackPanel>
                </TabItem>
              </TabControl>
            </StackPanel>
          </Viewbox>
        </TabItem>
        <TabItem Header="캐릭터">
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Width="440" Margin="0,12,0,0">
              <TextBlock Text="캐릭터 선택" FontWeight="SemiBold" Margin="8,0,8,6"/>
              <ComboBox x:Name="CharacterSelector" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" IsEnabled="{Binding CanChooseCharacter}" AutomationProperties.Name="캐릭터 선택" Margin="8,0,8,6" MinHeight="32" Foreground="Black" Background="White">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding CharacterStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="8,0,8,8"/>
              <TabControl Background="#F1F4F8" BorderThickness="0" Foreground="#172A3A" Padding="0">
                <TabItem Header="미리보기">
                  <StackPanel Margin="8,12,8,0">
                    <TextBlock Text="{Binding Character.Name}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Border Background="#EAF1F8" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,12" Padding="8">
                      <local:CharacterView DataContext="{Binding Character}" Height="150"/>
                    </Border>
                    <Button Content="캐릭터 방송창 열기 ↗" Command="{Binding BroadcastCommand}" Margin="0,0,0,12"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="방송창">
                  <StackPanel Margin="8,12,8,0">
                    <WrapPanel Margin="0,12,0,0">
                      <CheckBox Content="방송창 항상 위" IsChecked="{Binding Topmost}"/>
                      <CheckBox Content="초록 배경 (OBS 호환)" IsChecked="{Binding GreenBackground}"/>
                    </WrapPanel>
                    <Button Content="OBS 호환 방송창 열기" Command="{Binding ObsBroadcastCommand}" HorizontalAlignment="Left" FontSize="11" Padding="10,7" Margin="0,0,0,8"/>
                    <TextBlock Text="방송창은 유지됩니다. OBS 대상: VoxPet Character · Windows 10(1903 이상) 방식" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                    <TextBlock Text="방송창 크기 · 오른쪽 아래 모서리를 끌어도 조절할 수 있습니다." TextWrapping="Wrap" FontSize="12"/>
                    <DockPanel Margin="0,12,0,0">
                      <TextBlock Text="너비"/>
                      <TextBlock Text="{Binding BroadcastWidth, StringFormat={}{0:F0} DIP}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider Value="{Binding BroadcastWidth}" Minimum="200" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True" AutomationProperties.Name="방송창 너비"/>
                    <DockPanel>
                      <TextBlock Text="높이"/>
                      <TextBlock Text="{Binding BroadcastHeight, StringFormat={}{0:F0} DIP}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider Value="{Binding BroadcastHeight}" Minimum="200" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True" AutomationProperties.Name="방송창 높이"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="이미지 세트">
                  <StackPanel Margin="8,12,8,0" DataContext="{Binding Runtime}">
                    <TextBlock Text="그림은 밖에서 준비하고, 여기서 조합하세요" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock Text="머리·몸통·양팔·양다리 PNG + 표정·의상·무기 + 프레임 액션" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,12"/>
                    <WrapPanel><Button Content="이미지 세트 등록" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="등록 세트 적용" Command="{Binding RestoreCommand}"/><Button Content="기존 PNG 사용" Command="{Binding LegacyCommand}"/></WrapPanel>
                    <TextBlock Text="선택한 캐릭터용 imageset.json을 선택하세요. PNG는 같은 폴더의 상대 경로로 등록합니다. 원본을 보존하고 로컬 보관함에 복사합니다." TextWrapping="Wrap" FontSize="12" Margin="0,16,0,12"/>
                    <Button Content="제작 틀 저장…" Click="ExportImageTemplate" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="제작 틀에는 합성 예제 파츠·총기·소매·액션이 있습니다. 캐릭터 PNG를 직접 준비해 교체하세요." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="제작 가이드"><local:ImageSetGuide Margin="8,12,8,0"/></TabItem>
                <TabItem Header="PNG">
                  <StackPanel Margin="8,12,8,0">
                    <WrapPanel>
                      <Button Content="PNG 시트 불러오기" Command="{Binding ImportCharacterCommand}"/>
                      <Button Content="선택 캐릭터로 복원" Command="{Binding DefaultCharacterCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="입3열 또는8열 × 눈2행의 투명 PNG 시트를 사용할 수 있습니다." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16"/>
                  </StackPanel>
                </TabItem>
              </TabControl>
            </StackPanel>
          </Viewbox>
        </TabItem>
        <TabItem Header="표정" DataContext="{Binding Expressions}">
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Width="440" Margin="0,12,0,0">
              <TabControl Background="#F1F4F8" BorderThickness="0" Foreground="#172A3A" Padding="0">
                <TabItem Header="전환">
                  <StackPanel Margin="8,12,8,0">
                    <TextBlock Text="표정 · 단축키 슬롯" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding Slots}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Command="{Binding SwitchCommand}" Padding="8,6" FontSize="11" MaxWidth="140" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="편집">
                  <StackPanel Margin="8,12,8,0" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="편집할 슬롯" Margin="0,12,0,4"/>
                    <ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding Selected}" MinHeight="32" AutomationProperties.Name="표정 슬롯" Foreground="Black" Background="White">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Foreground="Black" Text="{Binding Label}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel Margin="0,8,0,0"><Button Content="↑ 위로" Command="{Binding MoveUpCommand}" Padding="8,6"/><Button Content="↓ 아래로" Command="{Binding MoveDownCommand}" Padding="8,6"/></WrapPanel>
                    <TextBlock Text="순서는 즉시 저장되며 F1~F12에도 적용됩니다." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                    <TextBlock Text="표정 이름" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Padding="6" AutomationProperties.Name="표정 이름"/>
                    <TextBlock Text="기본 표정" Margin="0,10,0,4"/>
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedValue="{Binding Selected.Kind}" SelectedValuePath="Key" MinHeight="32" AutomationProperties.Name="기본 표정" Foreground="Black" Background="White">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Foreground="Black" Text="{Binding Value}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel Margin="0,12,0,0">
                      <Button Content="표정 미리보기" Command="{Binding PreviewCommand}" Padding="8,6" FontSize="11"/>
                      <Button Content="슬롯 저장" Command="{Binding SaveCommand}" Padding="8,6" FontSize="11" Background="{StaticResource Accent}" Foreground="White"/>
                    </WrapPanel>
                  </StackPanel>
                </TabItem>
                <TabItem Header="PNG">
                  <StackPanel Margin="8,12,8,0" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="{Binding Selected.Label}" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Selected.SheetHint}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <WrapPanel Margin="0,8,0,0">
                      <Button Content="슬롯 PNG 선택" Command="{Binding ImportCommand}" Padding="8,6" FontSize="11"/>
                      <Button Content="내장 표정 사용" Command="{Binding BuiltinCommand}" Padding="8,6" FontSize="11"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,12,0,0">
                      <Button Content="표정 미리보기" Command="{Binding PreviewCommand}"/>
                      <Button Content="슬롯 저장" Command="{Binding SaveCommand}"/>
                    </WrapPanel>
                  </StackPanel>
                </TabItem>
                <TabItem Header="테스트">
                  <StackPanel Margin="8,12,8,0">
                    <TextBlock Text="새 표정 12종 미리보기" FontWeight="SemiBold"/>
                    <TextBlock Text="버튼을 누르면 새 얼굴을 확인합니다. 저장한 슬롯은 유지합니다." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,12"/>
                    <ItemsControl ItemsSource="{Binding TestExpressions}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Command="{Binding PreviewCommand}" Padding="10,7" Margin="0,0,6,6"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,12,0,0">
                      <Button Content="12종 전체 테스트" Command="{Binding DataContext.TestExpressionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,8"/>
                      <Button Content="테스트 중지" Command="{Binding StopTestCommand}" Padding="10,8"/>
                    </WrapPanel>
                    <TextBlock Text="입력이 꺼져 있으면 마이크 없이 데모로 입 움직임을 표시합니다." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}"/>
                  </StackPanel>
                </TabItem>
              </TabControl>
            </StackPanel>
          </Viewbox>
        </TabItem>
        <TabItem Header="눈물" DataContext="{Binding Expressions}">
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Width="440" Margin="0,12,0,0">
              <TextBlock Text="눈 깜빡임 · 눈물 모션" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Selected.Label}" Foreground="{StaticResource Accent}" Margin="0,12,0,8"/>
              <TextBlock Text="표정 탭에서 슬롯을 선택한 뒤 위치를 조정하고 저장하세요." TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
              <StackPanel IsEnabled="{Binding CanEdit}">
                <WrapPanel Margin="0,10,0,0">
                  <CheckBox Content="눈 깜빡임" IsChecked="{Binding Selected.Blink}"/>
                  <CheckBox Content="눈물 모션" IsChecked="{Binding Selected.Tears}"/>
                </WrapPanel>
                <TextBlock Text="눈물 위치 · 왼쪽 / 오른쪽 / 높이" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                <Slider Value="{Binding Selected.TearLeft}" Minimum="0" Maximum="1" AutomationProperties.Name="눈물 왼쪽 위치"/>
                <Slider Value="{Binding Selected.TearRight}" Minimum="0" Maximum="1" AutomationProperties.Name="눈물 오른쪽 위치"/>
                <Slider Value="{Binding Selected.TearTop}" Minimum="0" Maximum="0.8" AutomationProperties.Name="눈물 높이"/>
                <Border Background="#EAF1F8" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="8">
                  <local:CharacterView DataContext="{Binding Character}" Height="150"/>
                </Border>
                <WrapPanel>
                  <Button Content="표정 미리보기" Command="{Binding PreviewCommand}"/>
                  <Button Content="슬롯 저장" Command="{Binding SaveCommand}"/>
                </WrapPanel>
              </StackPanel>
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
            </StackPanel>
          </Viewbox>
        </TabItem>
        <TabItem Header="의상" DataContext="{Binding Wardrobe}">
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
            <StackPanel Width="440" Margin="0,12,0,0">
              <TabControl Background="#F1F4F8" BorderThickness="0" Foreground="#172A3A">
                <TabItem Header="세트 의상">
                  <StackPanel Margin="8,12,8,0" DataContext="{Binding DataContext.Runtime, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Text="의상 프리셋" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="몸통과 양쪽 소매를 하나의 세트로 착용합니다." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,16"/>
                    <ComboBox ItemsSource="{Binding OutfitNames}" SelectedIndex="{Binding OutfitIndex}" IsEnabled="{Binding CanUse}" MinHeight="36" Foreground="Black"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Border Background="{StaticResource Checkerboard}" CornerRadius="8" Margin="0,14,0,12" Padding="8">
                      <local:CharacterView DataContext="{Binding DataContext.Character, RelativeSource={RelativeSource AncestorType=Window}}" Height="200"/>
                    </Border>
                    <TextBlock Text="팔이 바뀌면 같은 포즈의 소매로 교체합니다. 위치는 외부 그림 도구에서 맞추며 이미지 세트에 함께 등록하세요." TextWrapping="Wrap" FontSize="12"/>
                    <Button Content="이미지 세트 등록" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    <TextBlock Text="기존 PNG 시트 모드의 개별 의상은 보관함·조정에서 사용할 수 있습니다." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="보관함">
                  <StackPanel Margin="8,12,8,0" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="이미지 추가 분류"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedValuePath="Key" SelectedValue="{Binding ImportCategory}" Margin="0,6,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <WrapPanel><Button Content="이미지 추가" Command="{Binding ImportCommand}" Padding="10,7"/><Button Content="의상 저장" Command="{Binding SaveCommand}" Padding="10,7"/><Button Content="모두 해제" Command="{Binding RemoveAllCommand}" Padding="10,7"/></WrapPanel>
                    <TextBlock Text="투명 PNG를 권장합니다. 클릭해 착용한 뒤 조정 탭에서 배치하세요." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,8"/>
                    <ComboBox ItemsSource="{Binding Filters}" SelectedIndex="{Binding FilterIndex}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <ListBox ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" Height="160" Background="#EAF1F8" BorderThickness="1" BorderBrush="{StaticResource SurfaceBorder}">
                      <ListBox.ItemTemplate><DataTemplate><DockPanel><CheckBox IsChecked="{Binding Enabled}" ToolTip="착용/해제" Margin="0,0,6,0"/><Button Command="{Binding WearCommand}" FontSize="11" Padding="6,5" HorizontalAlignment="Stretch" ToolTip="{Binding Label}"><TextBlock Text="{Binding Label}" FontSize="11" MaxWidth="260" TextTrimming="CharacterEllipsis"/></Button></DockPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="조정">
                  <StackPanel Margin="8,12,8,0" IsEnabled="{Binding CanAdjust}">
                    <TextBlock Text="{Binding Selected.CategoryName}" FontWeight="Bold"/>
                    <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Padding="5" Margin="0,5,0,8" AutomationProperties.Name="의상 이름"/>
                    <DockPanel><TextBlock Text="크기 · 비율 유지"/><TextBlock Text="{Binding Selected.SizePercent, StringFormat={}{0:F1}%}" HorizontalAlignment="Right"/></DockPanel>
                    <Slider Value="{Binding Selected.SizePercent}" Minimum="5" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="의상 크기" Margin="0,8,0,8"/>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,8,0"><TextBlock Text="X 위치"/><TextBox Text="{Binding Selected.X, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="의상 X 위치"/></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock Text="Y 위치"/><TextBox Text="{Binding Selected.Y, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="의상 Y 위치"/></StackPanel>
                    </Grid>
                    <WrapPanel><Button Content="← 1" Command="{Binding LeftCommand}" Padding="8,5"/><Button Content="↑ 1" Command="{Binding UpCommand}" Padding="8,5"/><Button Content="↓ 1" Command="{Binding DownCommand}" Padding="8,5"/><Button Content="→ 1" Command="{Binding RightCommand}" Padding="8,5"/></WrapPanel>
                    <TextBlock Text="숫자를 직접 입력하면 소수점 단위로도 이동합니다.512기준 좌표입니다." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,8"/>
                    <CheckBox Content="캐릭터 뒤에 표시" IsChecked="{Binding Selected.BehindCharacter}"/>
                    <WrapPanel><Button Content="앞으로" Command="{Binding UpLayerCommand}" Padding="8,5"/><Button Content="뒤로" Command="{Binding DownLayerCommand}" Padding="8,5"/><Button Content="보관함에서 삭제" Command="{Binding DeleteCommand}" Padding="8,5"/></WrapPanel>
                    <Button Content="의상 저장" Command="{Binding SaveCommand}" Margin="0,12,0,0" Background="{StaticResource Accent}" Foreground="White" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="움직임 연결">
                  <StackPanel Margin="8,12,8,0" IsEnabled="{Binding CanAdjust}">
                    <TextBlock Text="{Binding Selected.Label}" TextTrimming="CharacterEllipsis" FontWeight="Bold"/>
                    <TextBlock Text="따라갈 부위" Margin="0,12,0,6"/>
                    <ComboBox ItemsSource="{Binding AttachmentNames}" SelectedIndex="{Binding Selected.AttachmentIndex}" AutomationProperties.Name="의상 움직임 연결"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBlock Text="몸통 + 양쪽 소매: 손 영역 안의 옷이 팔과 함께 움직입니다. 모자·안경은 머리, 얼굴 장식은 입에 자동 연결됩니다." TextWrapping="Wrap" FontSize="12" Margin="0,12,0,8"/>
                    <TextBlock Text="{Binding Selected.FollowPercent, StringFormat=따라가는 정도 · {0:F0}%}"/>
                    <Slider Value="{Binding Selected.FollowPercent}" Minimum="0" Maximum="100" AutomationProperties.Name="의상 움직임 영향도" Margin="0,8,0,8"/>
                    <TextBlock Text="0%는 추가 움직임 없이 몸 전체만 따라갑니다. 위치·크기·연결 설정은 자동 저장됩니다." TextWrapping="Wrap" FontSize="11"/>
                    <Button Content="의상 저장" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                  </StackPanel>
                </TabItem>
              </TabControl>
            </StackPanel>
          </Viewbox>
        </TabItem>
        <TabItem Header="액션" DataContext="{Binding Hands}">
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
            <StackPanel Width="440" Margin="0,12,0,0" IsEnabled="{Binding CanEdit}">
              <TabControl Background="#F1F4F8" BorderThickness="0" Foreground="#172A3A">
                <TabItem Header="프레임 액션">
                  <StackPanel Margin="8,12,8,0" DataContext="{Binding DataContext.Runtime, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Text="02  액션 · 무기 · 의상" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="캐릭터 → 이미지 세트에서 먼저 등록하세요." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,6,0,12"/>
                    <StackPanel IsEnabled="{Binding CanUse}">
                      <TextBlock Text="액션"/><ComboBox ItemsSource="{Binding ActionNames}" SelectedIndex="{Binding ActionIndex}" Margin="0,6,0,10" Foreground="Black"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="의상 프리셋"/><ComboBox ItemsSource="{Binding OutfitNames}" SelectedIndex="{Binding OutfitIndex}" Margin="0,6,0,10" Foreground="Black"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="무기 이미지 세트"/><ComboBox ItemsSource="{Binding WeaponNames}" SelectedIndex="{Binding WeaponIndex}" Margin="0,6,0,10" Foreground="Black"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                      </Grid>
                      <Border Background="{StaticResource Checkerboard}" CornerRadius="8" Height="72" Margin="0,0,0,8"><Image Source="{Binding WeaponPreview}" Stretch="Uniform"/></Border>
                      <WrapPanel><Button Content="▶ 액션 재생" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="기본 상태 복귀" Command="{Binding ResetCommand}"/></WrapPanel>
                      <CheckBox Content="좌클릭마다 선택 액션 재시작 · 게임에서도 감지" IsChecked="{Binding LeftClick}"/>
                    </StackPanel>
                    <TextBlock Text="03  입력 설정" FontWeight="Bold" Margin="0,10,0,4"/>
                    <TextBlock Text="설정을 누른 뒤 키 입력 · Esc 취소 · Delete 해제" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding BindingRows}" IsEnabled="{Binding CanConfigure}"><ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Key}" VerticalAlignment="Center" Foreground="{StaticResource AccentHover}" FontSize="11"/>
                        <Button Grid.Column="2" Content="설정" Tag="{Binding Operation}" Click="RecordRuntimeKey" Padding="8,3" Margin="0"/>
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                  </StackPanel>
                </TabItem>
                <TabItem Header="기존 동작"><StackPanel Margin="8,12,8,0">
<ComboBox ItemsSource="{Binding Gestures}" SelectedIndex="{Binding SelectedIndex}" AutomationProperties.Name="손동작 종류" Margin="0,5,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><CheckBox Content="선택 동작 사용" IsChecked="{Binding Enabled}"/>
<ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" AutomationProperties.Name="손동작 실행 방식" Margin="0,5,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Width="190" Margin="0,0,8,8"><TextBlock Text="간격 (2~3600초)"/><TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="간격 (2~3600초)"/></StackPanel><ComboBox ItemsSource="{Binding Inputs}" SelectedIndex="{Binding InputIndex}" AutomationProperties.Name="손동작 입력" Margin="0,5,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><WrapPanel><StackPanel Width="190" Margin="0,0,8,0"><ComboBox ItemsSource="{Binding ModifierNames}" SelectedIndex="{Binding ModifierIndex}" AutomationProperties.Name="손동작 조합키" Margin="0,5,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Width="190"><ComboBox ItemsSource="{Binding Keys}" SelectedIndex="{Binding KeyIndex}" AutomationProperties.Name="손동작 키" Margin="0,5,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></WrapPanel>
                  <WrapPanel><Button Content="동작 시험" Command="{Binding PreviewCommand}"/><Button Content="현재 동작 멈춤" Command="{Binding StopCommand}"/></WrapPanel>
                  <TextBlock Text="좌클릭 동작은 한 개만 활성화됩니다. 항상·간격 모드는 입력 설정과 무관하게 실행됩니다. 시험은 마이크 없이 실행됩니다." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel></TabItem>
                <TabItem Header="기존 연결"><StackPanel Margin="8,12,8,0">
<ComboBox ItemsSource="{Binding Sides}" SelectedIndex="{Binding SideIndex}" AutomationProperties.Name="손 영역 선택" Margin="0,5,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Black"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><WrapPanel><CheckBox Content="이 손 / 날개 움직이기" IsChecked="{Binding LimbEnabled}"/><CheckBox Content="연결 영역 표시" IsChecked="{Binding Guides}"/></WrapPanel>
                  <WrapPanel><StackPanel Width="190" Margin="0,0,8,8"><TextBlock Text="손 영역 X"/><TextBox Text="{Binding LimbX, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="손 영역 X"/></StackPanel><StackPanel Width="190" Margin="0,0,8,8"><TextBlock Text="손 영역 Y"/><TextBox Text="{Binding LimbY, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="손 영역 Y"/></StackPanel><StackPanel Width="190" Margin="0,0,8,8"><TextBlock Text="손 영역 너비"/><TextBox Text="{Binding LimbWidth, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="손 영역 너비"/></StackPanel><StackPanel Width="190" Margin="0,0,8,8"><TextBlock Text="손 영역 높이"/><TextBox Text="{Binding LimbHeight, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="손 영역 높이"/></StackPanel></WrapPanel>
                  <Border Background="#EAF1F8" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="8">
                    <local:CharacterView DataContext="{Binding Character}" Height="150"/>
                  </Border>
                  <WrapPanel><Button Content="동작 시험" Command="{Binding PreviewCommand}"/><Button Content="캐릭터 연결 초기화" Command="{Binding ResetRigCommand}"/></WrapPanel>
                  <TextBlock Text="화면 기준 좌우입니다. 빨간 점은 손 회전축입니다. 팔과 소매만 들어가도록 영역을 조정하세요. 캐릭터별로 자동 저장됩니다." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel></TabItem>
                <TabItem Header="머리·입"><StackPanel Margin="8,12,8,0">
                  <CheckBox Content="머리 천천히 흔들기" IsChecked="{Binding HeadMotion}"/>
                  <TextBlock Text="머리 아래 경계 (64~400)" Margin="0,8,0,4"/>
                  <TextBox Text="{Binding HeadCut, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="머리 연결 경계"/>
                  <TextBlock Text="입을 최대한 열었을 때 장식 이동량 (0~48)" Margin="0,12,0,4"/>
                  <Slider Value="{Binding MouthTravel}" Minimum="0" Maximum="48" AutomationProperties.Name="입 장식 이동량"/>
                  <TextBlock Text="{Binding MouthTravel, StringFormat={}{0:F1}}"/>
                  <Border Background="#EAF1F8" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,8" Padding="8">
                    <local:CharacterView DataContext="{Binding Character}" Height="150"/>
                  </Border>
                  <TextBlock Text="머리 경계 아래에 손 영역을 배치하세요. 의상 → 움직임 연결에서 머리·입·손을 선택하면 장식도 함께 움직입니다. 영역 표시는 방송창에도 보입니다." TextWrapping="Wrap" FontSize="11"/>
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel></TabItem>
                <TabItem Header="동작 배치"><StackPanel Margin="8,12,8,0">
                  <TextBlock Text="선택한 손동작의 추가 이동·크기" FontWeight="Bold"/>
                  <WrapPanel Margin="0,12,0,0"><StackPanel Width="190" Margin="0,0,8,8"><TextBlock Text="손동작 X (-128~128)"/><TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="손동작 X (-128~128)"/></StackPanel><StackPanel Width="190" Margin="0,0,8,8"><TextBlock Text="손동작 Y (-128~128)"/><TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="손동작 Y (-128~128)"/></StackPanel></WrapPanel>
                  <TextBlock Text="크기 (50~150%)"/><Slider Value="{Binding ScalePercent}" Minimum="50" Maximum="150" AutomationProperties.Name="손동작 크기"/>
                  <Border Background="#EAF1F8" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,8" Padding="8">
                    <local:CharacterView DataContext="{Binding Character}" Height="150"/>
                  </Border>
                  <Button Content="동작 시험" Command="{Binding PreviewCommand}" HorizontalAlignment="Left"/>
                  <TextBlock Text="연결된 손 장식과 소매에도 같은 이동·크기를 적용합니다. 설정은 자동 저장됩니다." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel></TabItem>
              </TabControl>
            </StackPanel>
          </Viewbox>
        </TabItem>
      </TabControl>
    </Grid>
    <Border x:Name="StatusCard" Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" FontSize="12" Foreground="#CBD5E1" ToolTip="{Binding Status}"/>
        <TextBlock Text="{Binding SettingsStatus}" TextWrapping="Wrap" MaxHeight="48" FontSize="11" Foreground="#F59E0B">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SettingsStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
