<Window x:Class="VoxPet.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxPet · 목소리로 움직이는 캐릭터" Width="1000" Height="730" MinWidth="480" MinHeight="320" Background="#111927" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid x:Name="LayoutRoot" Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock Text="VoxPet" FontSize="32" FontWeight="Bold"/><TextBlock Text="목소리로 움직이는 작은 친구" Foreground="#8FA4BC" Margin="0,6,0,24"/></StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#213B38" CornerRadius="12" Padding="12,7"><TextBlock Text="●  로컬 음량 분석" Foreground="{StaticResource Accent}"/></Border>
    </Grid>
    <ScrollViewer x:Name="ContentViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="PanelsGrid">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="PreviewCard" Background="#1B2738" CornerRadius="18" Padding="24">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="캐릭터 미리보기" FontWeight="SemiBold" Foreground="#8FA4BC"/>
          <Image Grid.Row="1" Source="{Binding Character.Sprite}" Stretch="Uniform" Margin="0,18,0,18" RenderOptions.BitmapScalingMode="HighQuality"><Image.RenderTransform><TranslateTransform Y="{Binding Character.Bounce}"/></Image.RenderTransform></Image>
          <StackPanel Grid.Row="2">
            <TextBlock Text="VOICE LEVEL" FontSize="11" Foreground="#8FA4BC"/>
            <ProgressBar Value="{Binding VoiceLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="8" Foreground="{StaticResource Accent}" Background="#303D53" BorderThickness="0" Margin="0,10,0,8"/>
            <DockPanel><TextBlock Text="{Binding RawLevel, StringFormat=RAW {0:P0}}" FontSize="11" Foreground="#8FA4BC"/><TextBlock Text="{Binding VoiceLevel, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
            <TextBlock Text="{Binding Metrics}" FontFamily="Consolas" FontSize="11" Margin="0,12,0,18" TextWrapping="Wrap"/>
            <Button Content="캐릭터 방송창 열기 ↗" Command="{Binding BroadcastCommand}" Margin="0"/>
          </StackPanel>
        </Grid>
      </Border>
        <StackPanel x:Name="ControlsPanel" Grid.Column="2">
          <TextBlock Text="마이크" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="↻" ToolTip="마이크 장치 새로고침" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" IsEnabled="{Binding CanChooseDevice}" MinHeight="38" VerticalContentAlignment="Center" AutomationProperties.Name="마이크 선택"/></DockPanel>
          <WrapPanel Margin="0,12,0,24"><Button Content="Start" Command="{Binding StartCommand}" Background="{StaticResource Accent}" Foreground="#112C25" MinWidth="100"/><Button Content="Stop" Command="{Binding StopCommand}" MinWidth="100"/><Button Content="{Binding DemoLabel}" Command="{Binding DemoCommand}" FontSize="11" Padding="10,10"/></WrapPanel>
          <Border Background="#1B2738" CornerRadius="12" Padding="18">
            <StackPanel>
              <DockPanel><TextBlock Text="반응 조정" FontWeight="SemiBold"/><Button Content="기본값" Command="{Binding ResetCommand}" Padding="8,4" FontSize="11" HorizontalAlignment="Right" Margin="0"/></DockPanel>
              <DockPanel Margin="0,18,0,0"><TextBlock Text="Noise Gate"/><TextBlock Text="{Binding NoiseGate, StringFormat={}{0:F0} dBFS}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
              <Slider Value="{Binding NoiseGate}" Minimum="-90" Maximum="-10" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Noise Gate"/>
              <DockPanel><TextBlock Text="Sensitivity"/><TextBlock Text="{Binding Sensitivity, StringFormat={}{0:F2} ×}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
              <Slider Value="{Binding Sensitivity}" Minimum="0" Maximum="4" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Sensitivity"/>
              <DockPanel><TextBlock Text="Attack"/><TextBlock Text="{Binding AttackMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
              <Slider Value="{Binding AttackMs}" Minimum="0" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Attack"/>
              <DockPanel><TextBlock Text="Release"/><TextBlock Text="{Binding ReleaseMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
              <Slider Value="{Binding ReleaseMs}" Minimum="0" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" AutomationProperties.Name="Release" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <Expander Header="작은 목소리: 입력 반응 범위" Foreground="#DDE4F0" Margin="0,12,0,0">
            <StackPanel Margin="18,12,18,0">
              <TextBlock Text="작은 목소리에 반응하지 않으면 낮은 입력과 Gate를 함께 낮추세요." TextWrapping="Wrap" Foreground="#8FA4BC" FontSize="12" Margin="0,0,0,12"/>
              <DockPanel><TextBlock Text="낮은 입력"/><TextBlock Text="{Binding NormalizeMin, StringFormat={}{0:F0} dBFS}" HorizontalAlignment="Right"/></DockPanel>
              <Slider Value="{Binding NormalizeMin}" Minimum="-120" Maximum="-1" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="입력 범위 최소"/>
              <DockPanel><TextBlock Text="높은 입력"/><TextBlock Text="{Binding NormalizeMax, StringFormat={}{0:F0} dBFS}" HorizontalAlignment="Right"/></DockPanel>
              <Slider Value="{Binding NormalizeMax}" Minimum="-119" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="입력 범위 최대"/>
            </StackPanel>
          </Expander>
          <WrapPanel Margin="0,12,0,0"><CheckBox Content="방송창 항상 위" IsChecked="{Binding Topmost}"/><CheckBox Content="초록 배경 (OBS)" IsChecked="{Binding GreenBackground}"/></WrapPanel>
          <TextBlock Text="장치 변경은 Stop 후 선택하세요. Gate는 소음을 의미적으로 구별하지 않습니다." Foreground="#8FA4BC" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#1B2738" CornerRadius="10" Padding="14" Margin="0,20,0,0" MaxHeight="80"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/></ScrollViewer></Border>
  </Grid>
</Window>
