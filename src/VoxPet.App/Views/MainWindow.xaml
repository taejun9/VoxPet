<Window x:Class="VoxPet.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VoxPet.App.Views"
        Title="VoxPet · 목소리로 움직이는 캐릭터" Width="1000" Height="730" MinWidth="480" MinHeight="320" Background="#111927" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid x:Name="LayoutRoot" Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock x:Name="TitleText" Text="VoxPet" FontSize="32" FontWeight="Bold"/><TextBlock x:Name="SubtitleText" Text="목소리로 움직이는 작은 친구" Foreground="#8FA4BC" Margin="0,6,0,24"/></StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#213B38" CornerRadius="12" Padding="12,7"><TextBlock Text="●  로컬 음량 분석" Foreground="{StaticResource Accent}"/></Border>
    </Grid>
    <!-- 하나의 스크롤 영역을 공유한다. 작은 창의 한 열 전환은 code-behind가 담당한다. -->
    <ScrollViewer x:Name="ContentViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="PanelsGrid">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- 방송창과 같은 CharacterViewModel의 frozen PNG와 이동량을 표시한다. -->
      <Border x:Name="PreviewCard" VerticalAlignment="Top" Background="#1B2738" CornerRadius="18" Padding="24">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding Character.Name}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#8FA4BC"/>
          <local:CharacterView Grid.Row="1" DataContext="{Binding Character}" Margin="0,18,0,18"/>
          <StackPanel Grid.Row="2">
            <TextBlock Text="VOICE LEVEL" FontSize="11" Foreground="#8FA4BC"/>
            <ProgressBar Value="{Binding VoiceLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="8" Foreground="{StaticResource Accent}" Background="#303D53" BorderThickness="0" Margin="0,10,0,8"/>
            <DockPanel><TextBlock Text="{Binding RawLevel, StringFormat=RAW {0:P0}}" FontSize="11" Foreground="#8FA4BC"/><TextBlock Text="{Binding VoiceLevel, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
            <TextBlock Text="{Binding Metrics}" FontFamily="Consolas" FontSize="11" Margin="0,12,0,18" TextWrapping="Wrap"/>
            <Button Content="캐릭터 방송창 열기 ↗" Command="{Binding BroadcastCommand}" Margin="0"/>
          </StackPanel>
        </Grid>
      </Border>
        <StackPanel x:Name="ControlsPanel" Grid.Column="2">
          <TextBlock Text="마이크" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="↻" ToolTip="마이크 장치 새로고침" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" IsEnabled="{Binding CanChooseDevice}" MinHeight="38" VerticalContentAlignment="Center" AutomationProperties.Name="마이크 선택"/></DockPanel>
          <WrapPanel Margin="0,12,0,24"><Button Content="Start" Command="{Binding StartCommand}" Background="{StaticResource Accent}" Foreground="#112C25" MinWidth="100"/><Button Content="Stop" Command="{Binding StopCommand}" MinWidth="100"/><Button Content="{Binding DemoLabel}" Command="{Binding DemoCommand}" FontSize="11" Padding="10,10"/></WrapPanel>
          <CheckBox Content="캐릭터 음소거" IsChecked="{Binding CharacterMuted}"/>
          <TextBlock Text="{Binding MuteHint}" TextWrapping="Wrap" FontSize="11" Foreground="#8FA4BC" Margin="0,0,0,12"/>
          <Border Background="#1B2738" CornerRadius="12" Padding="18">
            <StackPanel>
              <DockPanel><TextBlock Text="반응 조정" FontWeight="SemiBold"/><Button Content="기본값" Command="{Binding ResetCommand}" Padding="8,4" FontSize="11" HorizontalAlignment="Right" Margin="0"/></DockPanel>
              <WrapPanel Margin="0,12,0,0"><Button Content="일반 대화" Command="{Binding ConversationCommand}" Padding="8,6" FontSize="11"/><Button Content="조용한 목소리" Command="{Binding SoftVoiceCommand}" Padding="8,6" FontSize="11"/><Button Content="빠른 반응" Command="{Binding SnappyCommand}" Padding="8,6" FontSize="11"/></WrapPanel>
              <DockPanel Margin="0,18,0,0"><TextBlock Text="Noise Gate"/><TextBlock Text="{Binding NoiseGate, StringFormat={}{0:F0} dBFS}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
              <Slider Value="{Binding NoiseGate}" Minimum="-90" Maximum="-10" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Noise Gate"/>
              <DockPanel><TextBlock Text="Sensitivity"/><TextBlock Text="{Binding Sensitivity, StringFormat={}{0:F2} ×}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
              <Slider Value="{Binding Sensitivity}" Minimum="0" Maximum="4" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Sensitivity"/>
              <DockPanel><TextBlock Text="Attack"/><TextBlock Text="{Binding AttackMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
              <Slider Value="{Binding AttackMs}" Minimum="0" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Attack"/>
              <DockPanel><TextBlock Text="Release"/><TextBlock Text="{Binding ReleaseMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
              <Slider Value="{Binding ReleaseMs}" Minimum="0" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" AutomationProperties.Name="Release" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <Expander Header="작은 목소리: 입력 반응 범위" Foreground="#DDE4F0" Margin="0,12,0,0">
            <StackPanel Margin="18,12,18,0">
              <TextBlock Text="작은 목소리에 반응하지 않으면 낮은 입력과 Gate를 함께 낮추세요." TextWrapping="Wrap" Foreground="#8FA4BC" FontSize="12" Margin="0,0,0,12"/>
              <DockPanel><TextBlock Text="낮은 입력"/><TextBlock Text="{Binding NormalizeMin, StringFormat={}{0:F0} dBFS}" HorizontalAlignment="Right"/></DockPanel>
              <Slider Value="{Binding NormalizeMin}" Minimum="-120" Maximum="-1" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="입력 범위 최소"/>
              <DockPanel><TextBlock Text="높은 입력"/><TextBlock Text="{Binding NormalizeMax, StringFormat={}{0:F0} dBFS}" HorizontalAlignment="Right"/></DockPanel>
              <Slider Value="{Binding NormalizeMax}" Minimum="-119" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="입력 범위 최대"/>
            </StackPanel>
          </Expander>
          <WrapPanel Margin="0,12,0,0"><CheckBox Content="방송창 항상 위" IsChecked="{Binding Topmost}"/><CheckBox Content="초록 배경 (OBS)" IsChecked="{Binding GreenBackground}"/></WrapPanel>
          <TextBlock Text="{Binding Character.Name}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <WrapPanel><Button Content="PNG 시트 불러오기" Command="{Binding ImportCharacterCommand}"/><Button Content="기본 캐릭터" Command="{Binding DefaultCharacterCommand}"/></WrapPanel>
          <TextBlock Text="{Binding CharacterStatus}" TextWrapping="Wrap" FontSize="11" Foreground="#8FA4BC" Margin="0,0,0,16"/>
          <Border Background="#1B2738" CornerRadius="12" Padding="18" Margin="0,0,0,12" DataContext="{Binding Expressions}">
            <StackPanel>
              <TextBlock Text="표정 · 단축키 슬롯" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" FontSize="11" Foreground="#8FA4BC" Margin="0,8,0,8"/>
              <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding SwitchCommand}" Padding="8,6" FontSize="11" ToolTip="마지막 저장된 표정으로 전환"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel IsEnabled="{Binding CanEdit}">
                <TextBlock Text="편집할 슬롯" Margin="0,12,0,4"/>
                <ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" MinHeight="32" AutomationProperties.Name="표정 슬롯"/>
                <TextBlock Text="표정 이름" Margin="0,10,0,4"/>
                <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Padding="6" AutomationProperties.Name="표정 이름"/>
                <TextBlock Text="기본 표정" Margin="0,10,0,4"/>
                <ComboBox ItemsSource="{Binding Kinds}" SelectedValue="{Binding Selected.Kind}" SelectedValuePath="Key" DisplayMemberPath="Value" MinHeight="32" AutomationProperties.Name="기본 표정"/>
                <WrapPanel Margin="0,10,0,0"><CheckBox Content="눈 깜빡임" IsChecked="{Binding Selected.Blink}"/><CheckBox Content="눈물 모션" IsChecked="{Binding Selected.Tears}"/></WrapPanel>
                <TextBlock Text="눈물 위치 · 왼쪽 / 오른쪽 / 높이" TextWrapping="Wrap" FontSize="11" Foreground="#8FA4BC"/>
                <Slider Value="{Binding Selected.TearLeft}" Minimum="0" Maximum="1" AutomationProperties.Name="눈물 왼쪽 위치"/>
                <Slider Value="{Binding Selected.TearRight}" Minimum="0" Maximum="1" AutomationProperties.Name="눈물 오른쪽 위치"/>
                <Slider Value="{Binding Selected.TearTop}" Minimum="0" Maximum="0.8" AutomationProperties.Name="눈물 높이"/>
                <local:CharacterView DataContext="{Binding Character}" Height="160" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Selected.SheetHint}" TextWrapping="Wrap" FontSize="11" Foreground="#8FA4BC"/>
                <WrapPanel Margin="0,8,0,0"><Button Content="슬롯 PNG 선택" Command="{Binding ImportCommand}" Padding="8,6" FontSize="11"/><Button Content="내장 표정 사용" Command="{Binding BuiltinCommand}" Padding="8,6" FontSize="11"/></WrapPanel>
                <WrapPanel><Button Content="표정 미리보기" Command="{Binding PreviewCommand}" Padding="8,6" FontSize="11"/><Button Content="슬롯 저장" Command="{Binding SaveCommand}" Padding="8,6" FontSize="11" Background="{StaticResource Accent}" Foreground="#112C25"/></WrapPanel>
              </StackPanel>
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="#8FA4BC" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="장치 변경은 Stop 후 선택하세요. Gate는 소음을 의미적으로 구별하지 않습니다." Foreground="#8FA4BC" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
    <!-- 마이크 수명 상태 안내. PNG 불러오기 안내는 조작부의 CharacterStatus에 따로 표시한다. -->
    <Border x:Name="StatusCard" Grid.Row="2" Background="#1B2738" CornerRadius="10" Padding="14" Margin="0,20,0,0" MaxHeight="80"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/></ScrollViewer></Border>
  </Grid>
</Window>
