<Application x:Class="VoxPet.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 앱 전체 색상과 기본 컨트롤 스타일. 오디오/캐릭터 상태는 스타일에 포함하지 않는다. -->
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#66E3C4"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DDE4F0"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E8EDF5"/><Setter Property="Background" Value="#303D53"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Panel" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Panel" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Panel" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DDE4F0"/><Setter Property="Margin" Value="0,8,20,8"/></Style>
    <Style TargetType="Slider"><Setter Property="Margin" Value="0,10,0,18"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="AutoToolTipPlacement" Value="TopLeft"/></Style>
  </Application.Resources>
</Application>
